# Never commit a real key.
GEMINI_API_KEY=AIza...
# Development default. Set gemini-3.8-flash for final validation/demo.
CONTRACTLENS_MODEL=gemini-3.5-flash-lite
# Optional deterministic replay date for demo screenshots.
# CONTRACTLENS_TODAY=2026-09-20
# Set 1 to run without Gemini. Local extraction/QA is intentionally narrower.
# CONTRACTLENS_OFFLINE=1
CONTRACTLENS_LOCAL_FALLBACK=1
CONTRACTLENS_ORIGINS=http://localhost:5173
